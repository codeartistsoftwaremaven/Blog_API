APP_NAME=Blog API
VERSION=1.0.0
DEBUG=false
# Replace for your own environment. The generated local .env has a random key.
SECRET_KEY=dev-only-replace-this-with-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite+aiosqlite:///./blog.db
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT=1
CACHE_TTL=300
VIEWS_FLUSH_THRESHOLD=100
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","blog.example.com"]
CORS_ORIGINS=["http://localhost:3000","https://blog.example.com"]
